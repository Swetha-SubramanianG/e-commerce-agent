# Server Configuration
PORT=3000

# AI Model Configuration
# Place your real AI API key here (e.g. from Google AI Studio, OpenAI, or Groq)
AI_API_KEY=your_api_key_here

# Provider options: 'gemini' (default, Google Gemini), 'openai' (OpenAI), or 'groq'
AI_PROVIDER=gemini

# Model name (Optional: defaults to gemini-1.5-flash for Gemini, gpt-4o-mini for OpenAI)
AI_MODEL=gemini-1.5-flash

# Demo Mode: 'auto' (default) uses built-in smart assistant if AI_API_KEY is not set.
# Set to 'false' if you want requests without valid keys to fail with standard error message.
DEMO_MODE=auto
